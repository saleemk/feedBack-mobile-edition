{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "fee[dB]ack Mobile Edition Setup Companion",
  "version": "0.1.0",
  "identifier": "com.saleemk.feedbackmobileedition.setupcompanion",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "fee[dB]ack Mobile Edition Setup Companion",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
